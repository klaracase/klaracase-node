{
  "name": "klaracase-node",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace for the official Klaracase TypeScript SDK packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaracase/klaracase-node.git"
  },
  "homepage": "https://klaracase.de",
  "bugs": {
    "url": "https://github.com/klaracase/klaracase-node/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "smoke": "pnpm --filter @klaracase/sdk run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}

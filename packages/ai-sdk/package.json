{
  "name": "@klaracase/ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK tools for the Klaracase API: search German case law, read decisions and norms, check citations.",
  "keywords": [
    "klaracase",
    "ai-sdk",
    "vercel",
    "tools",
    "german law",
    "citation check",
    "german case law",
    "rechtsprechung",
    "gesetze",
    "statutes",
    "legal research",
    "mcp"
  ],
  "license": "MIT",
  "author": "SPARQ VENTURES UG",
  "homepage": "https://klaracase.de/developers?ref=npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaracase/klaracase-node.git",
    "directory": "packages/ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/klaracase/klaracase-node/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copy-package-docs.mjs"
  },
  "peerDependencies": {
    "@klaracase/sdk": "^0.1.0",
    "ai": ">=5.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@klaracase/sdk": "workspace:*",
    "ai": "^5.0.283",
    "zod": "^4.1.8"
  }
}

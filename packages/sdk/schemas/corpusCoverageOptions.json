{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string",
      "enum": [
        "ordentlich",
        "verwaltung",
        "sozial",
        "arbeit",
        "finanz",
        "verfassung",
        "patent",
        "unbekannt"
      ],
      "description": "Court jurisdiction (Gerichtsbarkeit), not the legal subject area."
    },
    "top": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Cap on the per-court rows. Default 20."
    }
  },
  "additionalProperties": false,
  "title": "corpusCoverageOptions"
}

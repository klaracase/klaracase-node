{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "A decision UUID, an Aktenzeichen or an ECLI."
    },
    "direction": {
      "type": "string",
      "enum": [
        "outgoing",
        "incoming",
        "both"
      ],
      "description": "Which citations to follow. Default both."
    },
    "depth": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ],
      "description": "1 (default): direct neighbours. 2: neighbours of neighbours, a bounded sample."
    },
    "court": {
      "type": "string",
      "description": "Court short form, to disambiguate an Aktenzeichen."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Decision date, to disambiguate an Aktenzeichen."
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Page 1 to 20. Depth 1 only."
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "title": "getCitationGraphInput"
}

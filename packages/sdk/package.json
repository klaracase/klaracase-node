{
  "name": "@klaracase/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript and Node.js client for the Klaracase REST API (German case law and statutes).",
  "keywords": [
    "klaracase",
    "german law",
    "legal research",
    "citation check",
    "api client"
  ],
  "license": "MIT",
  "author": "SPARQ VENTURES UG",
  "homepage": "https://klaracase.de/docs/api",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "prepack": "node ../../scripts/copy-package-docs.mjs"
  }
}

{
  "name": "@klaracase/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript and Node.js client for the Klaracase REST API (German case law and statutes).",
  "keywords": [
    "klaracase",
    "german law",
    "legal research",
    "citation check",
    "api client",
    "german case law",
    "rechtsprechung",
    "gesetze",
    "statutes",
    "mcp"
  ],
  "license": "MIT",
  "author": "SPARQ VENTURES UG",
  "homepage": "https://klaracase.de/developers?ref=npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaracase/klaracase-node.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/klaracase/klaracase-node/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "schemas": [
        "./dist/schemas.d.ts"
      ],
      "tools": [
        "./dist/tools.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      },
      "require": {
        "types": "./dist/tools.d.cts",
        "default": "./dist/tools.cjs"
      }
    },
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/generate-json-schemas.mjs && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.exact.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "prepack": "node ../../scripts/copy-package-docs.mjs",
    "test:bun": "bun --bun ../../node_modules/vitest/vitest.mjs run",
    "test:edge": "vitest run --config vitest.edge.config.ts",
    "schemas:generate": "tsdown && node scripts/generate-json-schemas.mjs"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "zod": "^4.6.7"
  }
}
